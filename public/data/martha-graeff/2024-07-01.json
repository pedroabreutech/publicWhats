{"date":"2024-07-01","messages":[{"id":10147,"timestamp":"2024-07-01T04:04:40-03:00","date":"2024-07-01","time":"04:04:40","sender":"Martha Graeff","content":"Me avisa quando chegar em Sp e vemos te tentar falar hoje meu amor","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10148,"timestamp":"2024-07-01T05:07:41-03:00","date":"2024-07-01","time":"05:07:41","sender":"Martha Graeff","content":"","type":"image","is_edited":false,"attachment":"00010204-PHOTO-2024-07-01- 05-07-41.jpg","urls":[]},{"id":10149,"timestamp":"2024-07-01T05:41:19-03:00","date":"2024-07-01","time":"05:41:19","sender":"Martha Graeff","content":"Sofrendo de saudades","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10150,"timestamp":"2024-07-01T06:33:47-03:00","date":"2024-07-01","time":"06:33:47","sender":"DV","content":"Oi meu amor","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10151,"timestamp":"2024-07-01T06:42:25-03:00","date":"2024-07-01","time":"06:42:25","sender":"Martha Graeff","content":"Como você tá?","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10152,"timestamp":"2024-07-01T06:43:09-03:00","date":"2024-07-01","time":"06:43:09","sender":"DV","content":"Tudo bem amor","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10153,"timestamp":"2024-07-01T06:43:14-03:00","date":"2024-07-01","time":"06:43:14","sender":"DV","content":"To no voo ainda, acabei acordar","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10154,"timestamp":"2024-07-01T06:43:19-03:00","date":"2024-07-01","time":"06:43:19","sender":"DV","content":"devo pousar em 30 min","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10155,"timestamp":"2024-07-01T06:43:22-03:00","date":"2024-07-01","time":"06:43:22","sender":"DV","content":"E ai tudo bem?","type":"text","is_edited":false,"attachment":null,"urls":[]},{"id":10156,"timestamp":"2024-07-01T06:48:42-03:00","date":"2024-07-01","time":"06:48:42","sen