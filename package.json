{
  "name": "publicwhats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ingest": "node scripts/ingest.mjs",
    "chunk": "node scripts/chunk.mjs",
